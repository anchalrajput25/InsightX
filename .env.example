# Copy this file to .env and fill it in. Never share your real .env.

# --- Free AI models (add at least one key) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Needed when the app is online ---
# A long random text. Keeps people signed in and protects saved
# database passwords. Keep it the same forever; changing it signs
# everyone out and forgets saved connections.
INSIGHTX_AUTH_SECRET=
# One PostgreSQL database for InsightX's own data (accounts, chats,
# traces, saved answers, AI usage). Example from Neon:
# postgresql://user:password@ep-xxx.neon.tech/neondb?sslmode=require
INSIGHTX_APP_DB_URL=

# --- Optional ---
# INSIGHTX_AUTH_REQUIRED=1        # 0 turns sign-in off (only for your own PC)
# INSIGHTX_TRACING=1              # 0 turns traces off
# INSIGHTX_QUESTION_CACHE=1       # 0 turns saved answers off
# INSIGHTX_CONNECTION_DAYS=7      # forget a saved connection after this many unused days
